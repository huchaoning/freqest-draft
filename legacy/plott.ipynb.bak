    "                          1/HG_SPADE.CFI(np.linspace(0, 0.1, 100), (4/pi) * DMD.A(3), 0.2), linestyle=(0, (1, 1)), color=crb_color, zorder=3, alpha=0.8)\n",
    "\n",
