    "\n",
    "pm_crb, = axes[1, 2].plot(np.linspace(0, 0.1, 100), \n",
    "                          1/PM_SPADE.CFI(np.linspace(0, 0.1, 100), (4/pi) * DMD.A(5), 0.2), '--', color=crb_color, zorder=3, alpha=0.8)\n",
    "\n",
    "di_crb, = axes[1, 2].plot(np.linspace(0, 0.1, 100), \n",
